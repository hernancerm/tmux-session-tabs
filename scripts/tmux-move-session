#!/usr/bin/env bash

## Move the current tmux session left or right on the status line.
## The line is ordered by `@order`, so moving one is swapping its number with its neighbor's.
## `tmux-status-viewport` keeps those numbers a gapless 1..n, so the neighbor is one step away.
## @param:string $1 Direction, either 'left' or 'right'.

scripts="$(cd "$(dirname "$0")" && pwd -P)"

direction="${1}"

if [[ "${direction}" != 'left' && "${direction}" != 'right' ]]; then
  echo "Usage: $(basename "$0") <left|right>"
  exit 1
fi

# The session the client is on, not the one a hook happens to target.
current="$(tmux list-clients -F '#{session_id}' | head -1)"

if [[ -z "${current}" ]]; then
  exit
fi

position="$(tmux show-option -t "${current}" -qv @order)"
# A session with no `@order` yet reads empty, and the swap below writes this value back.
position=$(( position ))

if [[ "${direction}" = 'left' ]]; then
  target=$(( position - 1 ))
else
  target=$(( position + 1 ))
fi

neighbor="$(tmux list-sessions -f "#{==:#{@order},${target}}" -F '#{session_id}')"

if [[ -z "${neighbor}" ]]; then
  exit
fi

tmux set-option -t "${current}" @order "${target}"
tmux set-option -t "${neighbor}" @order "${position}"
"${scripts}/tmux-status-viewport"
