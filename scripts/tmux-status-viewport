#!/usr/bin/env bash

## Rebuild the status line: which sessions it shows, and in which order.
## Sessions sit in `@order` order, and the line fits as many as the client is wide, scrolling only
## when the current session falls outside them, so the sessions around it stay put.
## See `@status-skeleton` and `@session-item` in `session-tabs.tmux` for what it draws.

item="$(tmux show-option -gqv @session-item)"
skeleton="$(tmux show-option -gqv @status-skeleton)"
style_fill="$(tmux show-option -gqv @session-style-fill)"
style_sel="$(tmux show-option -gqv @session-style-sel)"
right_width="$(tmux show-option -gqv @session-right-text-width)"

# `was`, `measured`, `client_width`, `client_tty` and the `drawn_*` arrays are keyed by the number
# in the session id (`$3` -> 3): bash 3.2, the one macOS ships, has no associative arrays, and a
# session id is always `$` and a number.

# A line is built per session, not once for the server: `status-format` is a session option, so
# two clients on different sessions each get their own width and their own highlight. Two clients
# on one session still share a line, tmux has no per-client option; the narrower one decides, as
# tmux does when it sizes a shared session.
attached=()
client_width=()
client_tty=()
narrowest=0
width=""
sid=""
tty=""

while read -r width sid tty; do
  num="${sid#\$}"

  if [[ -z "${client_width[num]}" ]]; then
    attached+=("${sid}")
    client_width[num]="${width}"
    client_tty[num]="${tty}"
  elif (( width < client_width[num] )); then
    client_width[num]="${width}"
  fi

  if (( narrowest == 0 || width < narrowest )); then
    narrowest="${width}"
  fi
done < <(tmux list-clients -F '#{client_width} #{session_id} #{client_tty}')

# Order the sessions. A session without an `@order` goes last, in creation order: that is a session
# just created, and new ones belong at the end of the line. Hence the two sort keys: placed before
# new, then by `@order` or by the id, which counts up with every session tmux makes.
entries=()
was=()
drawn_start=()
drawn_left=()
drawn_right=()
drawn_line=()
entry=""
order=""
scroll=""
left=""
right=""
line=""
id=""

# What each session holds now rides along, rather than being asked for per session: every extra call
# to the server is felt as lag when a key is held down to switch or move sessions. The line goes
# last, `read` leaves the colons in it alone.
while IFS=: read -r id order scroll left right line; do
  num="${id#\$}"
  was[num]="${order}"
  drawn_start[num]="${scroll}"
  drawn_left[num]="${left}"
  drawn_right[num]="${right}"
  drawn_line[num]="${line}"

  if [[ -n "${order}" ]]; then
    entries+=("1 ${order} ${id}")
  else
    entries+=("2 ${id#\$} ${id}")
  fi
done < <(tmux list-sessions -F '#{session_id}:#{@order}:#{@sessions-viewport-start}:'\
'#{@sessions-hidden-left}:#{@sessions-hidden-right}:#{@sessions-line}')

# Index 0 stays empty: `ids[i]` is the session whose `@order` is `i`, and those count from 1.
ids=("")

# Guarded because `printf` with no arguments still runs its format once, which would feed the loop
# an empty line and put a session that does not exist on the line.
if (( ${#entries[@]} > 0 )); then
  while IFS= read -r entry; do
    ids+=("${entry##* }")
  done < <(printf '%s\n' "${entries[@]}" | sort -k1,1n -k2,2n)
fi

count=$(( ${#ids[@]} - 1 ))
i=0
num=""

# Renumber, so that `@order` stays a gapless 1..n that `tmux-move-session` can step through.
for (( i = 1; i <= count; i++ )); do
  num="${ids[i]#\$}"

  if [[ "${was[num]}" != "${i}" ]]; then
    tmux set-option -t "${ids[i]}" @order "${i}"
  fi
done

# Expanding the item per session is how its width is known: it depends on the label and the window
# names. Styles take no columns, so they come out first.
measured=()
text=""

while IFS= read -r entry; do
  id="${entry%% *}"
  text="${entry#* }"
  measured[${id#\$}]=${#text}
done < <(tmux list-sessions -F "#{session_id} ${item}" | sed 's/#\[[^]]*\]//g')

widths=("")
total=0

for (( i = 1; i <= count; i++ )); do
  num="${ids[i]#\$}"
  widths+=("${measured[num]}")
  total=$(( total + widths[i] ))
done

# The line for one client: `$1` columns wide, sitting on session `$2`, scrolled so that `$3` is the
# first session shown. Leaves the line in `line`, and the scroll position it settled on in `start`
# and `last`, which the caller stores back.
fit_line() {
  local width="$1" current="$2"
  local i position room avail

  # Past the end when the current session is not on the line, which keeps the fit loop below from
  # looking for it forever.
  position=$(( count + 1 ))

  for (( i = 1; i <= count; i++ )); do
    if [[ "${ids[i]}" = "${current}" ]]; then
      position=${i}
      break
    fi
  done

  # Columns the tabs may use: the client width less what `@session-right-text` was declared to take.
  room=$(( width - right_width ))
  # Room for the `<` and `>` counters, only needed once something is hidden.
  avail=$(( room - 8 ))
  start="$3"
  used=0
  last=0

  # `room <= 0` also covers having no client to measure, and keeps the fit loop below from running
  # with nothing to fill.
  if (( room <= 0 || total <= room )); then
    start=1
    last=${count}
  else
    if (( start < 1 || start > count )); then
      start=1
    fi
    if (( position < start )); then
      start=${position}
    fi

    # Fill the line from `start`, moving it right until the current session is among what fits.
    while true; do
      used=0
      last=$(( start - 1 ))

      for (( i = start; i <= count; i++ )); do
        if (( used + widths[i] > avail )); then
          break
        fi
        used=$(( used + widths[i] ))
        last=${i}
      done

      # A session wider than the whole line still has to show when it is the current one.
      if (( last < start )); then
        last=${start}
      fi
      if (( position <= last )); then
        break
      fi
      start=$(( start + 1 ))
    done

    # Sessions closed or shrunk to the right can leave room the viewport has not taken back.
    while (( last == count && start > 1 && used + widths[start - 1] <= avail )); do
      start=$(( start - 1 ))
      used=$(( used + widths[start] ))
    done
  fi

  # One loop per session, each filtered to a single id, so the line follows `ids` instead of the
  # name order `#{S:}` walks in. The style goes ahead of the loop: the item it wraps is the only
  # one that loop draws. Picking it here, rather than with a `#{?...}` in the format, is what the
  # comma in `bg=...,fg=...` forces: a format would read it as the separator between the branches
  # of the conditional. The item goes by reference, not copied in: every session holds a line, and
  # copies of the item in each would outgrow what one `tmux` call can carry, see `flush`.
  line=""

  # `#[none]` drops attributes the previous style turned on, e.g. `reverse` in a custom
  # `@session-style-sel`, which would otherwise carry into the next session.
  for (( i = start; i <= last; i++ )); do
    if [[ "${ids[i]}" = "${current}" ]]; then
      line+="#[none]#[${style_sel}]"
    else
      line+="#[none]#[${style_fill}]"
    fi

    line+="#{S:#{?#{==:#{session_id},${ids[i]}},#{E:@session-item},}}"
  done

  line="${skeleton//%%SESSIONS%%/${line}}"
}

# As few invocations as fit: every command to the server costs a process and a round trip, and this
# runs on every session switch, resize and window change. One call carries at most 16 KiB, past
# which tmux rejects it whole ("command too long"), so the writes go out in batches under that.
cmd=()
size=0
add=0
budget=12000

# Send what `cmd` holds, dropping the separator after its last command rather than rely on every
# supported tmux taking a trailing one. A failing hook script prints an error over the line, hence
# the silenced stderr.
flush() {
  if (( ${#cmd[@]} == 0 )); then
    return
  fi

  unset "cmd[$(( ${#cmd[@]} - 1 ))]"
  tmux "${cmd[@]}" 2>/dev/null
  cmd=()
  size=0
}

# The global line is what a session nobody is attached to draws, for the instant between a client
# attaching and the `client-attached` hook writing that session its own. Width 0 means every
# session shows, with none of them current.
fit_line 0 "" 1
cmd+=(set-option -g 'status-format[0]' "${line}" ';')
# Nothing is hidden on that line, and the counters fall back to the global when a session has none
# of its own.
cmd+=(set-option -g @sessions-hidden-left 0 ';')
cmd+=(set-option -g @sessions-hidden-right 0 ';')

# Every session gets its line, not only the attached ones: a switch draws the line the session
# already holds, and only then does the hook rewrite it. A stale one shows for that instant, e.g. a
# session closed since, and the tabs jump when the fresh one replaces it. A session no client is on
# is fit to the narrowest client.
for (( i = 1; i <= count; i++ )); do
  sid="${ids[i]}"
  num="${sid#\$}"
  width="${client_width[num]}"

  if [[ -z "${width}" ]]; then
    width="${narrowest}"
  fi

  fit_line "${width}" "${sid}" "${drawn_start[num]}"
  left=$(( start - 1 ))
  right=$(( count - last ))

  # Only what changed is written: each write costs tmux a pass over every session and client, and
  # most sessions' lines stay as they were. `@sessions-line` keeps a copy of the line to compare
  # against, since `status-format[0]` cannot be read back in a format. The 200 covers the other
  # commands and their ids.
  add=200
  if [[ "${line}" != "${drawn_line[num]}" ]]; then
    add=$(( add + 2 * ${#line} ))
  fi
  if (( size + add > budget )); then
    flush
  fi
  size=$(( size + add ))

  if [[ "${line}" != "${drawn_line[num]}" ]]; then
    cmd+=(set-option -t "${sid}" 'status-format[0]' "${line}" ';')
    cmd+=(set-option -t "${sid}" @sessions-line "${line}" ';')
  fi
  # The scroll position, kept across runs. Session-scoped like the line: two clients scrolled to
  # different places would otherwise fight over one number.
  if [[ "${start}" != "${drawn_start[num]}" ]]; then
    cmd+=(set-option -t "${sid}" @sessions-viewport-start "${start}" ';')
  fi
  if [[ "${left}" != "${drawn_left[num]}" ]]; then
    cmd+=(set-option -t "${sid}" @sessions-hidden-left "${left}" ';')
  fi
  if [[ "${right}" != "${drawn_right[num]}" ]]; then
    cmd+=(set-option -t "${sid}" @sessions-hidden-right "${right}" ';')
  fi
done

# The redraws go after every write, not next to the one they belong to: tmux stops a command
# sequence at the first failure, and `refresh-client` fails on a client that detached since
# `list-clients` ran.
for sid in "${attached[@]}"; do
  num="${sid#\$}"
  cmd+=(refresh-client -S -t "${client_tty[num]}" ';')
done

flush
exit 0
