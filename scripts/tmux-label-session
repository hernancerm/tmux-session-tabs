#!/usr/bin/env bash

## Label the current tmux session, and name the session after the label.
## The label is what the status line draws; the name is what `attach -t`, `switch-client -t` and
## `choose-tree` use. An empty label clears both: the name goes back to a number, as tmux would
## have named it.
## @param:string $1 The label. Empty to clear it.

scripts="$(cd "$(dirname "$0")" && pwd -P)"

label="${1}"
# `rename-session` turns `.` and `:` into `_`, so the name to claim is not always the label.
name="${label//[.:]/_}"

# The session the client is on, not the one a hook happens to target.
current="$(tmux list-clients -F '#{session_id}' | head -1)"

if [[ -z "${current}" ]]; then
  exit
fi

if [[ -n "${name}" ]]; then
  other="$(tmux list-sessions -f "#{&&:#{==:#{session_name},${name}},\
#{!=:#{session_id},${current}}}" -F '#{session_id}')"

  if [[ -n "${other}" ]]; then
    tmux display-message "duplicate session: ${name}"
    exit
  fi
fi

if [[ -z "${name}" ]]; then
  # Lowest free number, the name tmux gives a session when nobody names it.
  n=0

  while tmux has-session -t "=${n}" 2>/dev/null; do
    n=$(( n + 1 ))
  done

  name="${n}"
fi

tmux set-option -t "${current}" @label "${label}"
tmux rename-session -t "${current}" "${name}"
"${scripts}/tmux-status-viewport"
